[Unit]
Description=Agora agent-native desktop runtime
After=network.target

[Service]
Type=simple
Environment=HOME=/root
Environment=PATH=/root/.local/bin:/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin
ExecStart=/usr/local/bin/agora serve --home /var/lib/agora --listen 127.0.0.1:7788
Restart=on-failure
RestartSec=2
KillSignal=SIGINT
TimeoutStopSec=45
Delegate=yes
LimitNOFILE=65536
NoNewPrivileges=false
ProtectSystem=full
PrivateTmp=false

[Install]
WantedBy=multi-user.target
