{
  "name": "agora-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "blume dev",
    "build": "bun run copy-scripts && blume build",
    "copy-scripts": "for f in install.sh uninstall.sh; do [ -f ../scripts/$f ] && cp ../scripts/$f public/$f || true; done",
    "deploy": "bun run build && cf deploy"
  },
  "dependencies": {
    "blume": "^2.2.6"
  },
  "devDependencies": {
    "cf": "^1.0.0-beta.28",
    "wrangler": "^4.158.0"
  }
}
